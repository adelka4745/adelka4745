<Window
    x:Class="UwpPortfolioApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UwpPortfolioApp"
    Title="adelka4745 Toolkit">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="RootNavigation" SelectionChanged="RootNavigation_SelectionChanged" PaneDisplayMode="LeftCompact">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="Home" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="Проекты" Tag="Projects" Icon="AllApps" />
                <NavigationViewItem Content="Категории" Tag="Categories" Icon="Folder" />
                <NavigationViewItem Content="Языки" Tag="Languages" Icon="Code" />
                <NavigationViewItem Content="Помощь" Tag="Help" Icon="Help" />
                <NavigationViewItem Content="Заметки" Tag="Notes" Icon="Edit" />
                <NavigationViewItem Content="Настройки" Tag="Settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <ScrollViewer>
                <StackPanel Margin="24,20,24,24" Spacing="18">
                    <TextBlock x:Name="HeaderText"
                               Text="Главная"
                               FontSize="30"
                               FontWeight="Bold" />

                    <TextBlock x:Name="SubHeaderText"
                               Text="Личное портфолио и справочник разработчика"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="16" />

                    <ItemsRepeater x:Name="CardsRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="260" MinRowSpacing="16" MinColumnSpacing="16"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:InfoCard">
                                <Border Width="260"
                                        MinHeight="180"
                                        Padding="18"
                                        CornerRadius="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="18"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="WrapWholeWords" />
                                        <Border Padding="8,4,8,4"
                                                CornerRadius="8"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind Tag}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
