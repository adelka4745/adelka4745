<Window x:Class="UwpPortfolioApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="adelka4745 Toolkit"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B12">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#12131D" BorderBrush="#2E2E45" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <TextBlock Text="adelka4745" FontSize="28" FontWeight="Bold" Foreground="#F7F7FF" Margin="0,0,0,20"/>
                <TextBlock Text="PORTFOLIO / HELP" FontSize="12" Foreground="#6CF0FF" Margin="0,0,0,24"/>

                <Button Style="{StaticResource NavButtonStyle}" Content="Главная" Tag="Home" Click="NavButton_Click"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Проекты" Tag="Projects" Click="NavButton_Click"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Категории" Tag="Categories" Click="NavButton_Click"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Языки" Tag="Languages" Click="NavButton_Click"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Помощь" Tag="Help" Click="NavButton_Click"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Заметки" Tag="Notes" Click="NavButton_Click"/>
                <Button Style="{StaticResource NavButtonStyle}" Content="Настройки" Tag="Settings" Click="NavButton_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TitleText" Text="Главная" FontSize="32" FontWeight="Bold" Foreground="#F5F7FF"/>
                <TextBlock x:Name="SubtitleText" Text="Личное портфолио, проекты и помощник разработчика" Foreground="#A6B6D8" FontSize="15" Margin="0,8,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
